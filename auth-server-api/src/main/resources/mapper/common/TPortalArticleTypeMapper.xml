<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sxkj.edu.module.mapper.base.TPortalArticleTypeMapper">

    <select id="queryArticleTypePage" resultType="com.sxkj.edu.domain.mult.vo.TPortalArticleTypeVO">
        SELECT
            id,
            article_type_name,
            sort,
            is_enable,
            create_time
        FROM
            t_portal_article_type
        where is_valid = 1
        <if test="query.articleTypeName != null and query.articleTypeName != ''">
           and article_type_name like concat('%',#{query.articleTypeName},'%')
        </if>
        <if test="query.createTimeStart != null and query.createTimeEnd != null">
            and create_time between #{query.createTimeStart} and #{query.createTimeEnd}
        </if>
        order by sort
    </select>
</mapper>