<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sxkj.edu.module.mapper.website.TDownloadCenterMapper">
    <select id="selectDownloadCenterList" resultType="com.sxkj.edu.domain.base.down.TDownloadCenterAo">
        select *
        from t_download_center p
        where  p.is_valid=1
        <if test="query.name != null and query.name != ''">
            and (
            p.name like concat('%', #{query.name}, '%')
            )
        </if>
        <if test="query.startTime != null and query.endTime != null">
            and p.publish_date > #{query.startTime}
            and p.publish_date &lt; #{query.endTime}
        </if>
    </select>

</mapper>
