<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sxkj.edu.module.system.role.basic.RoleDao">

    <resultMap id="RoleEntity"
               type="com.sxkj.edu.module.system.role.basic.domain.entity.RoleEntity"></resultMap>


    <sql id="baseSql">
        r
        .
        id
        ,
        r.role_name,
        r.remark,
        r.update_time,
        r.create_time,
        r.is_valid
    </sql>
    <sql id="common_isValid">
        and r.is_valid=1
    </sql>

    <select id="getByRoleName" resultMap="RoleEntity">
        SELECT
        <include refid="baseSql"></include>
        FROM
        t_role r
        WHERE
        r.role_name = #{roleName}
        <include refid="common_isValid"></include>
    </select>

    <select id="rolePage" resultType="com.sxkj.edu.module.system.role.basic.domain.dto.RolePageVO">
        SELECT * FROM t_role
        where is_valid=1
        <if test="roleName!=null and roleName !=''">
            and role_name like concat('%',#{roleName},'%')
        </if>
        <if test="userIds != null and userIds.size > 0">
            AND id IN
            <foreach collection="userIds" open="(" close=")" item="item" separator=",">
                #{item}
            </foreach>
        </if>
    </select>

</mapper>